generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model refreshtoken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  refresh_hash  String
  expires_at    DateTime? @default(dbgenerated("(now() + '31 days'::interval)")) @db.Timestamptz(6)
  is_revoked    Boolean   @default(false)
  revoked_at    DateTime? @db.Timestamptz(6)
  replaced_by   String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  created_by_ip String?
  user_agent    String?
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refreshtoken_user_id")
}

model tasks {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  workout     Boolean   @default(false)
  commits     Int       @default(0)
  dsaq        Int       @default(0)
  platform    String?   @db.VarChar(50)
  project     String?   @db.VarChar(255)
  description String?
  other1      String?   @db.VarChar(255)
  other2      String?   @db.VarChar(255)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  date        DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  feedback    Int?
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tasks_user_id")

  @@unique([user_id, date], map: "idx_tasks_date_user_id")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role         String         @default("user")
  email        String         @unique
  username     String         @unique(map: "idx_user_username")
  password     String
  active       Boolean        @default(true)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  refreshtoken refreshtoken[]
  tasks        tasks[]
}
